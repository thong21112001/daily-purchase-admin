# ==============================================================================
# DAILY PURCHASE ADMIN - ENVIRONMENT VARIABLES (SECRET-ZERO POLICY)
# ==============================================================================
# Sao chép tệp này thành .env.local để sử dụng trong môi trường phát triển nội bộ.
# TUYỆT ĐỐI KHÔNG commit .env.local lên kho lưu trữ Git.

# Tài khoản Chủ sở hữu duy nhất (Single-Owner)
OWNER_USERNAME=admin_owner
# Mật khẩu quản trị hoặc mã PIN 6 số
OWNER_PASSWORD=change_this_password_or_pin_in_env_local

# Khóa bí mật ký JWT Session (tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=replace_with_a_secure_random_32_characters_secret_key_here

# Kết nối MongoDB Atlas (Free Tier M0 Cluster hoặc Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/daily_purchase_db?retryWrites=true&w=majority

# TÍCH HỢP MB BANK & VIETQR
# Khóa bí mật bảo vệ Webhook tiếp nhận biến động số dư (/api/webhooks/mbbank)
MBBANK_WEBHOOK_SECRET=your_mbbank_webhook_secret_key_here

# Cấu hình mã VietQR thanh toán nhanh tại quầy
NEXT_PUBLIC_MBBANK_ACCOUNT_NO=0905123456
NEXT_PUBLIC_MBBANK_ACCOUNT_NAME=NGUYEN VAN A

# Cổng khởi chạy (Tùy chọn, mặc định 3000)
PORT=3000
